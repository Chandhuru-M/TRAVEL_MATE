{
  "expo": {
    "name": "TRAVEL_MATE",
    "slug": "TRAVEL_MATE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow TRAVEL_MATE to use your camera to take trip photos.",
        "NSPhotoLibraryUsageDescription": "Allow TRAVEL_MATE to access your photo library to select trip photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow TRAVEL_MATE to save photos to your library."
      }
    },
  "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.chandhuru_m.TRAVEL_MATE",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TRAVEL_MATE to access your photos to pick trip images.",
          "cameraPermission": "Allow TRAVEL_MATE to use your camera to take trip photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3685d70e-da68-4e9f-bf9b-5dd22b424352"
      }
    }
  }
}
